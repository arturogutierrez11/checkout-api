PORT=3001
SERVICE_NAME=rituo-checkout-api

# Misma base de Neon que usan core.api y auth.api (una sola DB compartida).
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Clave que solo conoce web-rituo-front (header x-internal-api-key) para
# llamar a POST/GET /orders. Generá algo largo y random.
CHECKOUT_INTERNAL_API_KEY=replace-with-a-long-random-key

# Credenciales de Mercado Pago (panel de developers > Tus integraciones > Credenciales).
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clave secreta de la sección Webhooks del panel de MP (recomendado, valida las notificaciones).
MERCADOPAGO_WEBHOOK_SECRET=

RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Rituo <hello@rituo.io>"
# A quién avisar internamente cuando entra un pedido pago.
RESEND_ORDERS_NOTIFY_TO=hello@rituo.io

# Dominio público de web-rituo-front (sin barra final) — se usa para armar los
# back_urls (success/failure/pending) de Mercado Pago.
CHECKOUT_SITE_URL=https://rituo.io
# Dominio público de ESTE servicio (sin barra final) — se usa para el
# notification_url del webhook de Mercado Pago. Completar cuando esté deployado.
CHECKOUT_API_PUBLIC_URL=

CORS_ORIGINS=https://rituo.io
